# ===== Servidor =====
NODE_ENV=development
PORT=3000
# Desarrollo (Vite): http://localhost:5173 | docker compose: http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173

# ===== Autenticación =====
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d
# Opcional. Por defecto es true en producción. Pon false solo para probar Docker sobre http://localhost
# COOKIE_SECURE=false

# ===== Base de datos =====
# Usa una contraseña sin caracteres especiales, o codifícala en la URL
POSTGRES_USER=app_user
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=app_db
DATABASE_URL=postgresql://app_user:cambia_esta_password@localhost:5432/app_db?schema=public

# ===== APIs externas =====
# "API Read Access Token" de tu cuenta de TMDB (se envía como Bearer)
TMDB_API_KEY=pega-aqui-tu-api-read-access-token-de-tmdb
# Base de la API de anime (sin key). Cámbiala si apuntas a otra instancia.
# OJO: la API pública de Jikan (api.jikan.moe/v4) fue DESCONTINUADA el 1-oct-2026
# (ver jikan-me/jikan-rest#613). Por eso el valor por defecto usa Tenrai
# (https://api.tenrai.org/v1), de esquema compatible con Jikan v4 y sin cambios
# de código. Alternativas: una instancia propia de Jikan, o Jikan-Edge
# (https://jikan.lucashdo.com/v1, requiere adaptar el normalizador).
JIKAN_BASE_URL=https://api.tenrai.org/v1